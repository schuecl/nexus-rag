  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "description": "Standard OIDC basic scope -- explicit for the same reason as profile/email: a bare --import-realm doesn't create it. Carries the sub claim via oidc-sub-mapper; without it every token silently has no subject at all.",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "AUTH_TIME",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "nexus-rag-claims",
      "protocol": "openid-connect",
      "description": "Claims schema from REQUIREMENTS.md Section 6.2: groups, org, rag_roles. Clearance and Releasability are both derived app-side from rag-clearance:<value>/rag-releasability:<value> entries in rag_roles, not their own mappers.",
      "protocolMappers": [
        {
          "name": "groups-attr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org",
            "claim.name": "org",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "rag_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "rag-app",
            "claim.name": "rag_roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        },
        {
          "name": "audience-rag-app",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "rag-app",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "description": "Standard OIDC profile scope -- explicit because a bare --import-realm doesn't auto-create Keycloak's built-in default scopes; needed for 'preferred_username' to reach a token (referenced by both clients' defaultClientScopes).",
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "description": "Standard OIDC email scope -- same reason as 'profile' above for why this has to be explicit here.",
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "rag-app",
      "name": "Nexus RAG API (ingestion-api, orchestration-mcp)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-rag-app-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "basic",
        "nexus-rag-claims",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "librechat",
      "name": "LibreChat (throwaway dev instance)",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-librechat-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://localhost:3080/oauth/openid/callback"
      ],
      "webOrigins": [
        "https://localhost:3080"
      ],
      "defaultClientScopes": [
        "basic",
        "nexus-rag-claims",
        "profile",
        "email"
      ],
      "attributes": {
        "access.token.lifespan": "900",
        "use.refresh.tokens": "true",
        "standard.token.exchange.enabled": "true"
      }
    }
  ],
  "roles": {
    "client": {
      "rag-app": [
        {
          "name": "rag-ingest",
