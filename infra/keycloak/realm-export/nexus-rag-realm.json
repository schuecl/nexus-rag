        {
          "name": "rag-clearance:CUI",
          "description": "Cleared to Classification level CUI (FR-18/FR-26)"
        },
        {
          "name": "rag-clearance:SECRET",
          "description": "Cleared to Classification level SECRET (FR-18/FR-26)"
        },
        {
          "name": "rag-releasability:NOFORN",
          "description": "Holds the NOFORN Releasability caveat (FR-18/FR-20)"
        },
        {
          "name": "rag-releasability:USA",
          "description": "Holds the USA Releasability caveat (FR-18/FR-20)"
        },
        {
          "name": "rag-releasability:NATO",
          "description": "Holds the NATO Releasability caveat (FR-18/FR-20)"
        },
        {
          "name": "rag-releasability:FVEY",
          "description": "Holds the FVEY Releasability caveat (FR-18/FR-20)"
        },
        {
          "name": "rag-purge",
          "description": "Issue #123: destroy a document's content in every store (Qdrant chunks, object-store original, Postgres row). Separate from rag-admin, which grants no data access."
        }
      ]
    }
