{
  "annotations": {
    "list": []
  },
  "description": "One logs panel per component for tracing, plus Keycloak user-activity parsed from its event log. All from Loki.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Keycloak - user activity (login / logout / errors / admin)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Login outcomes (per 5m)",
      "description": "Parsed from Keycloak jboss-logging events (org.keycloak.events). Login errors climbing is the signal to watch.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=\"keycloak\"} |~ `type=\"LOGIN\"` [5m]))",
          "queryType": "range",
          "legendFormat": "logins"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=\"keycloak\"} |~ `type=\"LOGIN_ERROR\"` [5m]))",
          "queryType": "range",
          "legendFormat": "login errors"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=\"keycloak\"} |~ `type=\"LOGOUT\"` [5m]))",
          "queryType": "range",
          "legendFormat": "logouts"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=\"keycloak\"} |~ `type=\"CODE_TO_TOKEN\"` [5m]))",
          "queryType": "range",
          "legendFormat": "code->token"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 102,
      "type": "logs",
      "title": "Login errors & failures (who / why)",
      "description": "LOGIN_ERROR and other *_ERROR events, with username/ipAddress/error reason. Empty is good.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service=\"keycloak\"} |~ `_ERROR|error=`",
          "queryType": "range",
          "direction": "backward"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      }
    },
