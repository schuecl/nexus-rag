    {
      "id": 53,
      "type": "stat",
      "title": "Reranker fallback ratio",
      "description": "Share of queries that fell back to fused order because reranker-service was unreachable. Results still return, ranked worse.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(nexus_rag_reranker_fallback_total[30m])) / clamp_min(sum(rate(nexus_rag_queries_total[30m])), 0.0001)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
