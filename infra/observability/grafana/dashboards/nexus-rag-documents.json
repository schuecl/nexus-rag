      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "documents-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status='approved') AS \"approved\", count(*) FILTER (WHERE status='pending_review') AS \"pending\", count(*) FILTER (WHERE status='rejected') AS \"rejected\" FROM document_metrics"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
