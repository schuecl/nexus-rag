          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1h', 0), classification AS metric, count(*) AS value FROM document_metrics WHERE $__timeFilter(created_at) GROUP BY 1, classification ORDER BY 1"
