    {
      "id": 1,
      "type": "stat",
      "title": "Total documents",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "documents-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "documents-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS total FROM document_metrics"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Approved / Pending / Rejected",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "documents-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
