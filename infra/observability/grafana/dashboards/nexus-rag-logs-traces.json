        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate({compose_project=\"nexus-rag\"}[5m]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "I"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
