# Generated by infra/certs/generate-dev-certs.sh (Keycloak's HTTPS listener,
# added in #98) and by e2e.yml before `docker compose up`. Regenerated on
# demand and never shared -- private keys must not be committed even when
# they are throwaway dev material.
infra/certs/*.crt
infra/certs/*.key
infra/certs/*.srl

# Compose's local-override mechanism. Machine-specific accommodations live here
# (a host port already taken, a bind mount only this machine has) precisely so
# they are NOT project config -- docker-compose.yml stays the shared truth and a
# branch switch cannot silently revert a local workaround. Ignored because it is
# per-developer by construction, and because `git add -A` otherwise sweeps it
# into an unrelated commit, which is easy to miss in review and confusing to
# receive.
docker-compose.override.yml

# FR-30 retrieval trend store: local runs of scripts/evaluate_retrieval.py
# --history-dir land here (#429). CI keeps its own copy as a workflow artifact.
.eval-history/

# Issue #561: MkDocs build output (local `mkdocs build`/`serve` and the
# GitLab Pages job's --site-dir). The site is always built from source,
# never committed.
site/
public/
