# Copy to .env and adjust if needed. Defaults are dev-only, never use in production.

POSTGRES_USER=nexus_rag
POSTGRES_PASSWORD=nexus_rag
POSTGRES_DB=nexus_rag

# NFR-3: the app, Keycloak, and LiteLLM each get separate, non-superuser
# database roles -- POSTGRES_USER above is the bootstrap superuser, used only
# by infra/postgres/init-app-roles.sh, ensure-roles.sh, and the
# lock-down-db-grants one-shot, never for day-to-day traffic.
# KEYCLOAK_DB_USER and LITELLM_DB_USER each get their own separate database
# (KEYCLOAK_DB_NAME / LITELLM_DB_NAME).
#
# #278 (gap G2): one role per service, each holding only the privileges that
# service actually uses. The exact matrix lives in
# infra/postgres/apply-service-grants.sh; the headline is that no *application*
# role gets SELECT on audit_log (only the standalone AUDIT_REPORTING_DB_USER
# below does, issue #309), orchestration-mcp cannot read documents at all, and
# the worker has no access to the session/OAuth tables.
#
# Rotating any of these takes effect on the next `up`: ensure-roles.sh resets
# the password on every run, deliberately, so a changed value here cannot
# silently disagree with what the service is configured to use.
INGESTION_API_DB_USER=nexus_rag_ingestion_api
INGESTION_API_DB_PASSWORD=nexus_rag_ingestion_api
INGESTION_WORKER_DB_USER=nexus_rag_ingestion_worker
INGESTION_WORKER_DB_PASSWORD=nexus_rag_ingestion_worker
ORCHESTRATION_MCP_DB_USER=nexus_rag_orchestration_mcp
ORCHESTRATION_MCP_DB_PASSWORD=nexus_rag_orchestration_mcp
# The former shared application role. Nothing connects as it since #278; it is
# still created so apply-service-grants.sh can reassign the tables it owns on
# an upgraded deployment and strip its privileges. Left with CONNECT only, so
# a stale DATABASE_URL fails with a permission error naming the table rather
# than looking like the database is down.
APP_DB_USER=nexus_rag_app
APP_DB_PASSWORD=nexus_rag_app
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=keycloak_app
KEYCLOAK_DB_NAME=keycloak
LITELLM_DB_USER=litellm_app
LITELLM_DB_PASSWORD=litellm_app
LITELLM_DB_NAME=litellm
# postgres-exporter's scrape role under the opt-in observability profile
# (#133): pg_monitor + CONNECT on POSTGRES_DB, no table privileges. Its own
# role rather than APP_DB_USER -- pg_monitor is cluster-wide read of every
# session's activity, which the application credential should not carry.
MONITORING_DB_USER=nexus_rag_monitor
MONITORING_DB_PASSWORD=nexus_rag_monitor
# Issue #309 (Phase 4 of #138): SELECT-only role for
# scripts/calibrate_tagging_advisory.py, the offline job that mines curator
# corrections from audit_log to measure suggester-vs-curator agreement. Not
# one of the four service roles above -- see the note two paragraphs up.
AUDIT_REPORTING_DB_USER=nexus_rag_audit_reporting
AUDIT_REPORTING_DB_PASSWORD=nexus_rag_audit_reporting

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Embedding model served by Ollama (Section 7.2)
EMBEDDING_MODEL=nomic-embed-text
# Upload size guard in bytes (FR-9/NFR-7), default 50MB.
MAX_UPLOAD_BYTES=52428800
# Chunking target size (words) and overlap ratio (FR-4, Section 2 starting point).
CHUNK_TARGET_WORDS=512
CHUNK_OVERLAP_RATIO=0.15
# Optional per-content-type reranking score multiplier (issue #89), JSON
# object e.g. {"table": 1.15}. Leave unset for no boost (default).
CONTENT_TYPE_BOOSTS=
# Throwaway generation model for exercising LibreChat -> LiteLLM -> Ollama end to end.
# Not a production model choice. llama3.2:1b was tried first (smallest/fastest to pull)
# but its tool-calling is unreliable -- confirmed live (issue #99 follow-up, 2026-07-26):
# even a single-required-field tool schema only got a correctly-formed tool_calls response
# ~1 in 5 tries, and it sometimes invented a function name that didn't exist. qwen2.5:7b-
# instruct got 5/5 clean tool calls against the real rag_search schema in the same test --
# needs a GPU or patience (no GPU: expect Ollama to run this at CPU speed) and ~5GB more
# disk than llama3.2:1b, but is what makes MCP tool-calling testing viable at all.
GENERATION_MODEL=qwen2.5:3b-instruct
# Optional vision model for image/figure captioning at ingestion (issue #92).
# Empty (the default) disables captioning entirely: no model pull, no VLM
# calls, no behavior change. Set to a vision-capable Ollama model to enable,
# e.g. moondream (~1.7GB, fast enough on CPU) or granite3.2-vision (~2.4GB,
# stronger on charts/document figures) -- ollama-model-init pulls it on the
# next `up` when set.
VISION_MODEL=
# Optional model for LLM zero-shot classification/doc_type/program_community
# suggestions at ingestion (issue #308, Phase 3 of #138). Empty (the default)
# disables the feature entirely: no model pull, no extra LLM calls, no
# behavior change. Set to an Ollama text-generation model to enable --
# GENERATION_MODEL's value works (it's already pulled), or a smaller/
# dedicated model -- ollama-model-init pulls it on the next `up` when set.
CLASSIFICATION_MODEL=
# Optional model for the LLM-assisted PII/sensitive-info advisory pass at
# ingestion (issue #343, Phase 2 of #342) -- context-dependent sensitive
# personal/financial info (spelled-out SSNs, foreign ID formats, freeform
# PII in prose) the deterministic regex pass (common/pii_scan.py) can't
# catch. Empty (the default) disables the feature entirely: no model pull,
# no extra LLM calls, no behavior change. Set to an Ollama text-generation
# model to enable -- GENERATION_MODEL's value works (it's already pulled),
# or a smaller/dedicated model -- ollama-model-init pulls it on the next
# `up` when set.
PII_LLM_MODEL=

# ---------------------------------------------------------------------------
# GPU vs CPU (#165)
# ---------------------------------------------------------------------------
# Two independently-GPU-capable pieces: Ollama (embeddings + generation) and
# reranker-service (the cross-encoder). Both default to CPU so `docker compose
# up` works on any laptop with no drivers.
#
# reranker-service: which torch wheel gets baked into its image at BUILD time.
# Default is the CPU wheel (~5 GB smaller than CUDA -- the CUDA default is what
# exhausts a small disk). For a GPU host, point this at the matching CUDA index
# AND uncomment the reranker `deploy.resources` GPU reservation in
# docker-compose.yml. Air-gapped builds point it at the internal mirror.
#   local/CPU (default): https://download.pytorch.org/whl/cpu
#   GPU example:         https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
#
# Ollama uses the GPU automatically when the NVIDIA Container Toolkit is
# installed and its `deploy.resources` GPU reservation (also in
# docker-compose.yml) is uncommented; with no GPU it silently runs on CPU.
# Prereqs for the GPU path (host, not in this file): NVIDIA driver +
# nvidia-container-toolkit + Docker configured with the nvidia runtime. See
# docs/dev-setup.md's "Running on a GPU host" note.

LITELLM_MASTER_KEY=sk-dev-litellm-master-key

LIBRECHAT_KEYCLOAK_CLIENT_SECRET=dev-librechat-secret
RAG_APP_KEYCLOAK_CLIENT_SECRET=dev-rag-app-secret

# Issue #213: encrypts UserSession's stored access/refresh/id tokens at rest
# (common/token_crypto.py) so a read-only compromise of the app database
# alone doesn't yield usable Keycloak credentials. Must be a Fernet key
# (32 url-safe base64-encoded bytes) -- generate a real one for anything
# beyond throwaway local dev: `python3 -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())"`. Losing/rotating this key
# just forces every active session to re-login (rows are ephemeral, bounded
# by SESSION_LIFETIME), not a data-loss event.
SESSION_TOKEN_ENCRYPTION_KEY=VDwCC09I-Kf3YNJMRhkUN1bkC0bCXc9cxh7agmNqsIM=
# Issue #281 gap G5 stage 2: set only while rotating the key above -- tried
# via MultiFernet if the current key fails to decrypt a row, so sessions
# written under the old key keep working until it's retired. See
# docs/credential-rotation.md.
SESSION_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# LibreChat's own session JWTs and stored-credential encryption -- required at
# startup regardless of auth method (confirmed live: LibreChat refuses to
# start without these). JWT_SECRET/JWT_REFRESH_SECRET have no length
# requirement; CREDS_KEY/CREDS_IV do (LibreChat validates them as AES-256-CBC
# key/IV -- 32 and 16 bytes respectively). Generate real values for anything
# beyond throwaway local dev: `openssl rand -hex 32` (JWT_SECRET,
# JWT_REFRESH_SECRET, CREDS_KEY) and `openssl rand -hex 16` (CREDS_IV).
LIBRECHAT_JWT_SECRET=6d5695c76c088051803a2711a694dc2a8c3e184b97ca2696639b663e289cb6bd
LIBRECHAT_JWT_REFRESH_SECRET=e6ee049ff1278d2d966accf4a498589cfa8f2e90a239a36195ecea193606444c
LIBRECHAT_CREDS_KEY=b981603e3853e792749bd57a37263dcac98f05e9bcc3221b28ea9ce1d31407f6
LIBRECHAT_CREDS_IV=59ac382baf239caa9f8bb22863d45e41

# NFR-15: Qdrant requires authenticated access in every environment, including
# dev -- anonymous read/write is never acceptable. QDRANT_API_KEY is full
# read/write (ingestion-worker, which creates the collection and writes new
# points; ingestion-api also holds it to update/delete points on
# approve/reject/supersede); QDRANT_READ_ONLY_API_KEY is read-only
# (orchestration-mcp, which only queries).
QDRANT_API_KEY=dev-qdrant-key
QDRANT_READ_ONLY_API_KEY=dev-qdrant-readonly-key

# Issue #216: reranker-service's /rerank otherwise has no authorization model
# of its own beyond network reachability. Shared by orchestration-mcp (sends
# it as a header) and reranker-service (checks it) -- same value on both
# sides, same as the Qdrant keys above. Change it if this stack is reachable
# by anything you don't trust.
RERANKER_SHARED_SECRET=dev-reranker-shared-secret
# Issue #281 gap G5 stage 2: set only while rotating RERANKER_SHARED_SECRET
# above -- reranker-service accepts either value until you unset this and
# restart it, so orchestration-mcp and reranker-service don't have to switch
# to the new value in the same instant. See docs/credential-rotation.md.
RERANKER_SHARED_SECRET_PREVIOUS=

# #160/#163: one vector backend is selected by the application. Qdrant is
# the default and its bundled UI is at http://127.0.0.1:6333/dashboard.
# To use Milvus instead, set VECTOR_BACKEND=milvus and start Compose with
# `--profile milvus`; Attu then runs at http://127.0.0.1:${ATTU_PORT}.
# MILVUS_TOKEN is the user:password credential shared by the app services;
# the dev-only bootstrap value below is also what you enter in Attu.
VECTOR_BACKEND=qdrant
MILVUS_URL=http://milvus:19530
MILVUS_TOKEN=root:Milvus
ATTU_PORT=8000

# NFR-11: durable ingestion job queue (common/job_queue.py). Issue #212:
# ingestion-api (publish-only) and ingestion-worker (consume-only) each get
# their own credential -- infra/nats/nats.conf's authorization block is what
# actually restricts each to its own subjects; these passwords alone don't.
NATS_INGESTION_API_PASSWORD=dev-nats-api-password
NATS_INGESTION_WORKER_PASSWORD=dev-nats-worker-password

# ---------------------------------------------------------------------------
# Observability (#133) -- opt-in
# ---------------------------------------------------------------------------
# The Prometheus/Grafana/Loki/Tempo/Alloy stack is off by default. Turn it on:
#   docker compose --profile observability up -d
#
# Starting that profile does NOT by itself turn on tracing or structured logs
# -- Tempo will have no spans and Grafana's trace-to-logs links will have
# nothing to match on until you also set the two variables below. Uncomment
# them here rather than passing them inline on the `up` command: an inline
# variable is lost the moment a container is recreated from Docker Desktop or
# a plain `docker compose up`, and the only symptom is a startup line reading
# "tracing disabled" that is easy to miss.
#
# Both are commented out by default because they are only meaningful when the
# observability profile is running: otel-collector does not exist otherwise,
# and the services would retry an export that can never succeed.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# LOG_FORMAT=json
# Grafana admin (change for anything but local dev):
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=nexus-rag-admin

# #164: durable Postgres -> JetStream hand-off reconciliation.
QUEUE_RECONCILE_INTERVAL_SECONDS=15
QUEUE_RECONCILE_BATCH_SIZE=100

# #133: scoped read-only DB role for the Grafana "Documents" dashboard --
# SELECT on the document_metrics view only (governance metadata, no filenames).
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=grafana_ro

# #214: orchestration-mcp's /debug/rag_search is a curl-shaped development
# convenience. Authorization is enforced on it, so leaving it enabled is not a
# hole -- but nothing in a deployed environment needs it. Set to false to
# remove it from the image's route table.
DEBUG_RAG_SEARCH_ENABLED=true
